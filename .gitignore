# Build artifacts
dist/
build/
*.tsbuildinfo
*.js
*.html
*.ico
*.svg
*.png
*.webmanifest

# Brand logo assets are versioned deliberately -- the global *.png rule above
# would otherwise drop them silently and ship a site with no logo.
!public/brand/
!public/brand/*.png
!public/brand/*.svg
!public/brand/*.webp

# App-router icons. The global *.png rule above would drop them and ship the
# default Vercel favicon instead.
!src/app/icon.png
!src/app/apple-icon.png

# Allow committed screenshot assets in public/screenshots
!public/screenshots/
!public/screenshots/*.svg
!public/screenshots/*.png


# Dependencies
node_modules/

