{
  "id": "enztronic",
  "name": "Enztronic",
  "interval_days": 14,
  "urls": [
    {"url": "https://enztronic.com/", "status": 200, "required_headers": {"strict-transport-security": "max-age=", "content-security-policy": "object-src 'none'", "x-content-type-options": "nosniff"}},
    {"url": "https://www.enztronic.com/", "status": 200, "required_headers": {"strict-transport-security": "max-age="}},
    {"url": "https://enztronic.com/id", "status": 200, "required_headers": {"content-security-policy": "object-src 'none'"}},
    {"url": "https://enztronic.com/zh", "status": 200, "required_headers": {"content-security-policy": "object-src 'none'"}}
  ],
  "docker_containers": [],
  "docker_checks_required": false,
  "host_checks_required": false,
  "commands": [
    {"name": "website", "timeout": 3600, "full_only": true, "parser": "check-bundle"}
  ],
  "discord_env": "ENZTRONIC_DISCORD_WEBHOOK_URL",
  "discord_file_only": true,
  "retention_days": 90
}
