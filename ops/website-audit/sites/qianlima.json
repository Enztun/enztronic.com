{
  "id": "qianlima",
  "name": "Qianlima",
  "interval_days": 14,
  "urls": [
    {"url": "https://qianlima.co.id/", "status": 200, "required_headers": {"strict-transport-security": "max-age=", "content-security-policy": "script-src-attr 'none'", "x-content-type-options": "nosniff"}},
    {"url": "https://www.qianlima.co.id/", "status": 200, "required_headers": {"content-security-policy": "script-src-attr 'none'", "x-frame-options": "DENY"}},
    {"url": "https://www.qianlima.co.id/dashboard/company", "status": 200, "required_headers": {"content-security-policy": "'strict-dynamic'", "cache-control": "no-store"}},
    {"url": "https://api.qianlima.co.id/healthz", "status": 200}
  ],
  "docker_containers": ["qianlima_backend"],
  "commands": [
    {"name": "production-behavior", "argv": ["python3", "/home/deploy/website-audit/production_smoke.py"], "timeout": 240, "full_only": false, "category": "production-smoke"},
    {"name": "frontend", "argv": ["python3", "/home/deploy/website-audit/repository_check.py", "qianlima-frontend"], "timeout": 3600, "full_only": true, "parser": "check-bundle"},
    {"name": "backend", "argv": ["python3", "/home/deploy/website-audit/repository_check.py", "qianlima-backend"], "timeout": 3600, "full_only": true, "parser": "check-bundle", "required_categories": ["audit-prod", "audit-full", "outdated", "lint", "unit", "build", "gitleaks"]}
  ],
  "discord_env": "DISCORD_WEBHOOK_URL",
  "discord_secret_file": "/home/deploy/.config/website-audit/discord.env",
  "retention_days": 90,
  "disk_path": "/"
}
