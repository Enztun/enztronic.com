+} finally {
+  if (Test-Path -LiteralPath $officeTemporary) { Remove-Item -LiteralPath $officeTemporary -Force }
+  $officeKeyText = $null
+}
+$officePlan.applied = $true
+$officePlan | ConvertTo-Json
