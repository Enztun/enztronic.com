# Runtime: the application must remain loopback-only behind Cloudflare Tunnel.
NODE_ENV=development
BACKOFFICE_HOST=127.0.0.1
BACKOFFICE_PORT=3100

# Dedicated local PostgreSQL cluster created by scripts/setup-local.ps1.
# The setup script creates an isolated role, password, and database automatically.
DATABASE_URL=postgresql://enztronic_app:replace-with-a-long-random-password@127.0.0.1:54329/enztronic_backoffice

# Cloudflare Access. Use the Self-hosted application's AUD tag, not an account ID.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=replace-with-access-application-aud
CLOUDFLARE_ACCESS_ALLOWED_EMAILS=owner@example.com

# Local-only escape hatch. Production rejects this even if accidentally enabled.
CLOUDFLARE_ACCESS_DEV_BYPASS=false
CLOUDFLARE_ACCESS_DEV_EMAIL=developer@example.com

# Private Cloudflare R2 bucket and bucket-scoped API token.
R2_ACCOUNT_ID=00000000000000000000000000000000
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=enztronic-invoices-private

# Resend sending key and a sender on a verified domain.
RESEND_API_KEY=re_replace-with-resend-api-key
RESEND_FROM_EMAIL=Enztronic Billing <billing@example.com>
RESEND_REPLY_TO=accounts@example.com
RESEND_BCC=

# ReportLab renderer inside this app's isolated Python environment.
PDF_PYTHON_EXECUTABLE=D:\Enztronic\apps\backoffice\.venv\Scripts\python.exe
PDF_RENDERER_PATH=pdf/render_invoice.py
PDF_RENDER_TIMEOUT_MS=15000
PDF_MAX_INPUT_BYTES=1048576
PDF_MAX_OUTPUT_BYTES=10485760
